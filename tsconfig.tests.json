{
  // TEST program — type-checked by `npm run typecheck:tests`, and COMPILED into
  // `dist/` by `npm run build:tests`, because the Mocha suite runs on the emitted
  // JavaScript (`.mocharc` globs `./dist/test/**/*.test.js`), not on the sources.
  //
  // `tsconfig.json` went `strict: true` at the end of the TypeScript migration
  // (docs/adr-001/steps/12-sprint-9-strict-flip.md, K6). `strict` applies to a whole
  // program, so keeping the specs in that program would have meant either ~770 strict
  // errors in the build's path or dropping the type-check on the test code entirely.
  // This file is the third option: the specs keep exactly the checking they had before
  // the flip — `strict: false`, `allowJs: true` for the Mocha specs still in JavaScript
  // — and `lib/` keeps strict. Hardening these is step 13's business, not K6's.
  "extends": "./tsconfig.json",
  //
  // It emits to the same `dist/` the production build does, at the same paths it
  // used to reach when both lived in one program. `npm run build` no longer emits
  // `dist/test/**`, so `test:unit:mocha` runs `build:tests` first — miss that and
  // Mocha exits 1 with "No test file(s) found", which is how this was caught.
  "compilerOptions": {
    "strict": false,
    "allowJs": true,
    "noUncheckedIndexedAccess": false
  },
  "include": [
    // Ambient declarations for untyped Node internals. They are `.d.ts`, so nothing
    // imports them and the program would not pull them in on its own: `lib/` used to
    // carry them into the shared program via its own glob, and dropping `lib/**` from
    // here loses `process.moduleLoadList` in lib/kuzzle/dumpGenerator.ts. See
    // docs/adr-001/steps/10-sprint-7-kuzzle.md.
    "lib/types/**/*.d.ts",
    // Unit tests vitest
    "tests/**/*.ts",
    "tests/**/*.js",
    "tests/**/*.json",
    // Unit tests mocha
    "test/**/*.ts",
    "test/**/*.js",
    "test/**/*.json",
    // Functional tests
    "features/**/*.ts",
    "features-legacy/**/*.ts",
    // development files
    "start-kuzzle-test.ts",
    "start-kuzzle-dev.ts"
  ],
  "exclude": [
    "dist"
  ]
}
