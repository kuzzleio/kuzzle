{
  "compilerOptions": {
    "outDir": "dist",
    // TypeScript 6 no longer infers it from the input files. `.` is what it
    // inferred from `lib/`, `index.ts` and `bin/`, so `dist/` keeps its layout.
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "listEmittedFiles": true,
    "module": "commonjs",
    "target": "es2020",
    "lib": ["es2022", "dom", "dom.iterable"],
    // `node` (node10) is deprecated by TypeScript 6. `bundler` is its
    // replacement for a `commonjs` output: it only changes how imports are
    // resolved for type-checking, never the emitted JavaScript (`node16` would
    // turn `import()` into a native ESM import at runtime).
    "moduleResolution": "bundler",
    // `bundler` honours `exports`, and `sdk-es7` (@elastic/elasticsearch 7)
    // exposes its type subpaths only through the folder mapping `"./": "./"`,
    // which TypeScript does not support. This keeps `sdk-es7/api/types` &co
    // resolving, so the specifiers in the published `.d.ts` do not change.
    // (`baseUrl`, deprecated by TypeScript 6, is gone: nothing used it.)
    "paths": {
      "sdk-es7/*": ["./node_modules/sdk-es7/*"]
    },
    "sourceMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "types": [
      "node",
      "vitest",
      "@cucumber/cucumber"
    ]
  },
  // This is the PRODUCTION program, and the one `npm run build` emits `dist/` from:
  // `lib/`, the package entrypoint, and the binaries — nothing else. `strict` is a
  // property of a *program*, not of a file, so the tests cannot be exempted from it
  // while sharing this one; they have their own program in `tsconfig.tests.json`,
  // which is type-checked by `npm run typecheck:tests`. Widening this `include` back
  // over `tests/` or `features/` puts ~770 strict errors in the build's path.
  // See docs/adr-001/steps/12-sprint-9-strict-flip.md (K6).
  "include": [
    // Kuzzle core files
    "lib/**/*.ts",
    "lib/**/*.json",
    "index.ts",
    // Binaries
    "bin/copy-binaries.ts",
    "bin/start-kuzzle-server.ts"
  ],
  "exclude": [
    "dist"
  ]
}
