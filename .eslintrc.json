{
  "plugins": [
    "kuzzle"
  ],
  "extends": [
    "plugin:kuzzle/default",
    "plugin:kuzzle/node"
  ],
  "parserOptions": {
    "ecmaVersion": 2020
  },
  "rules": {
    "sort-keys": "warn",
    "kuzzle/array-foreach": "warn"
  },
  "overrides": [
    {
      "files": [
        "*.ts"
      ],
      "extends": [
        "plugin:kuzzle/typescript"
      ],
      "rules": {
        "@typescript-eslint/no-explicit-any": "warn",
        "@typescript-eslint/ban-ts-comment": [
          "error",
          {
            "ts-expect-error": "allow-with-description",
            "ts-ignore": true,
            "ts-nocheck": true,
            "ts-check": false,
            "minimumDescriptionLength": 20
          }
        ]
      }
    }
  ]
}
